{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动 eureka-service（注册中心 8888）",
      "type": "shell",
      "command": "mvn -pl eureka-service spring-boot:run '-Dspring-boot.run.jvmArguments=-Xmx512m -Xms128m'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "isBackground": true
    },
    {
